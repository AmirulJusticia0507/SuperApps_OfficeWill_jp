APP_NAME=OfficeWill
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-host.example

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=officewill_production
DB_USERNAME=officewill_app
DB_PASSWORD=replace-with-a-secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=your-host.example

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=replace-with-a-secret
MAIL_PASSWORD=replace-with-a-secret
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-host.example
MAIL_FROM_NAME="${APP_NAME}"
